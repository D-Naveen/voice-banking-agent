# Copy to .env for local runs. NEVER commit real keys; set them in your host's env settings.
DATABASE_URL=sqlite:///./voice_banking.db
AUTO_SEED=true
# Set true when served over HTTPS (Render/Fly/Cloud Run)
COOKIE_SECURE=false

# ---- Anti-spoof detector (pick ONE provider; leave empty = PIN step-up for every voice payment)
# SPOOF_PROVIDER=huggingface          # local model, needs requirements-spoof.txt + ffmpeg
# SPOOF_HF_MODEL=<huggingface-model-id>
# SPOOF_HF_SPOOF_LABELS=fake,spoof,deepfake,ai,synthetic   # labels that mean "spoof" for THAT model
# SPOOF_PROVIDER=http                 # hosted service: multipart 'file' -> {"score":0..1,"is_spoof":bool}
# SPOOF_DETECTOR_URL=https://your-detector.example/score
